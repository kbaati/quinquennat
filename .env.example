# Copier ce fichier en .env pour changer les ports publiés ou le mot de passe de la base.
FRONTEND_PORT=3000
BACKEND_PORT=8080
MOTEUR_PORT=8000

# Mot de passe de la base PostgreSQL locale. À changer pour tout déploiement.
DATABASE_PASSWORD=quinquennat

# Témoignages fictifs. REACTIONS_ENABLED=false les désactive entièrement.
REACTIONS_ENABLED=true
# "fake" : phrases d'exemple sans appel à une IA (aucun coût). "anthropic" : génération par Claude (payant).
REACTIONS_GENERATOR=fake
# Plafond de témoignages générés par jour (ceux déjà en cache ne comptent pas).
REACTIONS_MAX_PER_DAY=2000
# Requis seulement avec REACTIONS_GENERATOR=anthropic. Ne jamais committer la clé.
ANTHROPIC_API_KEY=
# Identifiant du modèle, par exemple claude-opus-5-5 (plus fin) ou claude-haiku-5-5 (bien moins cher).
ANTHROPIC_MODEL=
